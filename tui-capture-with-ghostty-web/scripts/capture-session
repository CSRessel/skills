#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: capture-session <session> <output-dir> --cols N --rows N [--expect TEXT] [--require-color]" >&2
}

if [[ $# -lt 6 ]]; then
  usage
  exit 2
fi

session=$1
output_dir=$2
shift 2
cols=""
rows=""
expect_text=""
require_color=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cols)
      cols=${2:-}
      shift 2
      ;;
    --rows)
      rows=${2:-}
      shift 2
      ;;
    --expect)
      expect_text=${2:-}
      shift 2
      ;;
    --require-color)
      require_color=true
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ ! $cols =~ ^[1-9][0-9]*$ ]]; then
  echo "--cols must be a positive integer" >&2
  exit 2
fi
if [[ ! $rows =~ ^[1-9][0-9]*$ ]]; then
  echo "--rows must be a positive integer" >&2
  exit 2
fi

skill_dir=$(cd "$(dirname "$0")/.." && pwd)
sibling_tui_dir="$skill_dir/../tui-puppeteering-with-tmux"
codex_tui_dir="${CODEX_HOME:-$HOME/.codex}/skills/tui-puppeteering-with-tmux"
tui_dir=""

for candidate in "${TUI_PUPPETEERING_DIR:-}" "$sibling_tui_dir" "$codex_tui_dir"; do
  if [[ -n $candidate && -x "$candidate/tmux-isolated" && -x "$candidate/tui-assert" && -x "$candidate/tui-capture" ]]; then
    tui_dir=$candidate
    break
  fi
done
if [[ -z $tui_dir ]]; then
  echo "tui-puppeteering-with-tmux not found; install it beside this skill or set TUI_PUPPETEERING_DIR" >&2
  exit 1
fi

output_parent=$(dirname "$output_dir")
output_name=$(basename "$output_dir")
mkdir -p "$output_parent"
if [[ -e $output_dir ]]; then
  if [[ ! -d $output_dir || -n $(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    echo "output directory must be absent or empty: $output_dir" >&2
    exit 1
  fi
fi
staging_dir=$(mktemp -d "$output_parent/.${output_name}.capture.XXXXXX")
cleanup() {
  if [[ -n ${staging_dir:-} && -d $staging_dir ]]; then
    rm -r "$staging_dir"
  fi
}
trap cleanup EXIT

"$tui_dir/tmux-isolated" resize-window -t "$session" -x "$cols" -y "$rows"
if [[ -n $expect_text ]]; then
  "$tui_dir/tui-assert" "$session" "$expect_text"
fi
"$tui_dir/tui-capture" "$session" > "$staging_dir/screen.txt"
"$tui_dir/tui-capture" "$session" -e > "$staging_dir/screen.ansi"
if [[ $require_color == true ]] && ! LC_ALL=C grep -Eq $'\033\[(3[0-7]|9[0-7]|38;|4[0-7]|10[0-7]|48;)' "$staging_dir/screen.ansi"; then
  echo "capture contains no ANSI foreground/background color SGR; clear NO_COLOR and advertise COLORTERM=truecolor" >&2
  exit 1
fi
bun "$skill_dir/scripts/render-ansi.ts" \
  --input "$staging_dir/screen.ansi" \
  --output "$staging_dir/screen.png" \
  --cols "$cols" \
  --rows "$rows" > "$staging_dir/metadata.json"

if [[ -d $output_dir ]]; then
  rmdir "$output_dir"
fi
mv "$staging_dir" "$output_dir"
staging_dir=""
trap - EXIT

printf '%s\n' "$output_dir/screen.txt" "$output_dir/screen.png" "$output_dir/metadata.json"
